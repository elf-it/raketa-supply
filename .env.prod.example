# Скопируйте в .env рядом с docker-compose.prod.yml и заполните.
# Этот файл — образец, в нём нет и не должно быть настоящих значений.

# Пароль базы. Без него compose не поднимется.
POSTGRES_PASSWORD=
POSTGRES_USER=raketa
POSTGRES_DB=raketa

# Ключ подписи сессионных токенов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Вне отладки приложение не стартует со значением по умолчанию: токен,
# подписанный общеизвестным ключом, подделывается кем угодно.
SECRET_KEY=

# Порт, на котором интерфейс виден снаружи.
WEB_PORT=8080

# Адрес, по которому интерфейс открывают в браузере. Должен совпадать
# с тем, что видит браузер, иначе сессионная кука не доедет.
CORS_ORIGINS=http://localhost:8080

# Сколько доверенных прокси перед приложением. В этом compose их один (nginx);
# если впереди встанет ещё один — с HTTPS, — поставьте 2.
TRUSTED_PROXY_HOPS=1

# Кука только по HTTPS. Оставлять false можно лишь при проверке на localhost:
# без HTTPS сессионная кука уходит по открытому каналу.
COOKIE_SECURE=true

# Общий кэш расчёта на все процессы. Пусто — кэш живёт в памяти каждого
# процесса, как и было. Со службой `cache` (профиль `cache` в compose):
#   CALC_CACHE_URL=redis://cache:6379/0
# По замерам на 1080 парах он себя не окупает — см. docs/08-performance.md.
CALC_CACHE_URL=

# Источник данных: http — реальный API Wildberries, fixtures — файлы из образа.
WB_CLIENT=http
# Ключи кабинетов: store01=eyJhbGciOi...,store02=eyJhbGciOi...
WB_TOKENS=
