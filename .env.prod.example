# Скопируйте в .env рядом с docker-compose.prod.yml и заполните.
# Этот файл — образец, в нём нет и не должно быть настоящих значений.

# Пароль базы. Без него compose не поднимется.
POSTGRES_PASSWORD=
POSTGRES_USER=raketa
POSTGRES_DB=raketa

# Ключ подписи сессионных токенов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Вне отладки приложение не стартует со значением по умолчанию: токен,
# подписанный общеизвестным ключом, подделывается кем угодно.
SECRET_KEY=

# Порт, на котором интерфейс виден снаружи.
WEB_PORT=8080

# Адрес привязки этого порта. Когда впереди стоит свой nginx с TLS (как на
# atl73.ru — см. deploy/), порт нужен только с самой машины: 127.0.0.1.
# Публикация портов в Docker идёт мимо ufw, поэтому 0.0.0.0 здесь открывает
# порт из интернета независимо от фаервола.
WEB_BIND=0.0.0.0

# Адрес, по которому интерфейс открывают в браузере. Должен совпадать
# с тем, что видит браузер, иначе сессионная кука не доедет.
CORS_ORIGINS=http://localhost:8080

# Сколько доверенных прокси перед приложением. В этом compose их один (nginx);
# если впереди встанет ещё один — с HTTPS, — поставьте 2.
TRUSTED_PROXY_HOPS=1

# Кука только по HTTPS. Оставлять false можно лишь при проверке на localhost:
# без HTTPS сессионная кука уходит по открытому каналу.
COOKIE_SECURE=true

# Общий кэш расчёта на все процессы. Пусто — кэш живёт в памяти каждого
# процесса, как и было. Со службой `cache` (профиль `cache` в compose):
#   CALC_CACHE_URL=redis://cache:6379/0
# По замерам на 1080 парах он себя не окупает — см. docs/08-performance.md.
CALC_CACHE_URL=

# Доставка алертов о сбоях загрузки. Пусто — система о себе не сообщает,
# и о сбое узнаёт только внешний мониторинг по /health/ready и человек
# по плашке на экране. Заполнять нужно либо весь блок почты, либо ничего:
# SMTP_HOST без ALERT_EMAIL_TO (и наоборот) — отказ старта, потому что это
# выглядит как настроенные алерты и ведёт себя как их отсутствие.
# Проверить канал: docker compose -f docker-compose.prod.yml run --rm \
#   backend python -m app.alerts --test
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Входящий вебхук мессенджера: Slack, Mattermost или Telegram (с chat_id).
# Это секрет: в адресе входящего вебхука лежит ключ.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_CHAT_ID=

# Через сколько часов напоминать о неисправленном сбое; 0 — не напоминать.
ALERT_REPEAT_HOURS=24

# Пульс наружу: адрес сторожа, который ждёт сигнала и шумит, когда тот пропал
# (healthchecks.io, push-проверка Uptime Kuma, Dead Man's Snitch). Это
# единственный способ узнать, что система мертва: о собственной смерти она
# сообщить не может. Это секрет — в адресе ключ проверки.
HEARTBEAT_URL=

# Источник данных: http — реальный API Wildberries, fixtures — файлы из образа.
WB_CLIENT=http
# Ключи кабинетов: store01=eyJhbGciOi...,store02=eyJhbGciOi...
# Ключу нужны две категории WB: «Статистика» (продажи, заказы)
# и «Аналитика» (отчёт об остатках).
WB_TOKENS=

# Откуда брать остатки: report — отчёт /api/v1/warehouse_remains в три шага
# (так описано в документации сейчас), legacy — прежний путь
# /api/v1/supplier/stocks. Второй оставлен запасным: ни один из двух
# не проверен на боевом ключе.
WB_STOCKS_SOURCE=report
