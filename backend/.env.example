# Скопируйте в backend/.env и поправьте под себя. Все значения необязательны.

# SQLite по умолчанию; для Postgres:
# DATABASE_URL=postgresql+psycopg://raketa:raketa@localhost:5432/raketa
DATABASE_URL=sqlite:///./raketa.db

# fixtures — локальные файлы, http — реальный API Wildberries
WB_CLIENT=fixtures

# Ключи кабинетов задаются только здесь, в базе не хранятся:
# WB_TOKENS=store01=eyJhbGciOi...,store02=eyJhbGciOi...
WB_TOKENS=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ключ подписи сессионных токенов. Вне отладки приложение не стартует со значением
# по умолчанию: токен, подписанный общеизвестным ключом, подделывается кем угодно.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
SESSION_TTL_HOURS=12

# Отдавать сессионную куку только по HTTPS. В проде обязательно true.
COOKIE_SECURE=false
